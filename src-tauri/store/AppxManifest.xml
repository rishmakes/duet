<?xml version="1.0" encoding="utf-8"?>
<!--
  Duet as a Microsoft Store package. scripts/store-msix.ps1 fills in the version and packs it.
  The identity comes from Partner Center and must never change, or the Store treats it as another app.
  Write virtualization is off so Duet and the AI tools it starts keep their files where they always
  are (the home folder, Documents, the AI tools' own settings), not in a hidden Store copy.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop desktop6 rescap">

  <Identity Name="rishmakes.Duet-DesignalongwithAI" Publisher="CN=36BCB9B8-C4AF-4D0C-8D42-5BADA9FF2006" Version="__VERSION__" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Duet: Design with AI</DisplayName>
    <PublisherDisplayName>rishmakes</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Duet" Executable="duet-app.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Duet"
        Description="Design with an AI, side by side"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- a short name with a fixed place, so an AI tool can start Duet's bridge after every update -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="duet-app.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="duet.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="duet">
            <uap:DisplayName>Duet project</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.duet</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
