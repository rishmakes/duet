{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duet",
  "version": "0.11.0",
  "identifier": "com.justsourish.duet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Duet",
        "width": 1440,
        "height": 900,
        "dragDropEnabled": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$HOME/.duet/previews/**",
          "$HOME/.duet-dev/previews/**",
          "/Volumes/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "fileAssociations": [
      {
        "ext": [
          "duet"
        ],
        "name": "Duet project",
        "description": "A Duet design, with its history inside",
        "role": "Editor",
        "mimeType": "application/x-duet-project"
      }
    ],
    "shortDescription": "Design with an AI, side by side",
    "longDescription": "An opinionated design tool, built by designers, for designers. You and your AI work hand in hand on one canvas.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": {
      "binaries/ffmpeg-licences/*": "ffmpeg-licences/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2QUYwNUQxNjE0M0YwMTEKUldRUjhFTmgwUVd2cGdtK3hxeFYzbVN2dmQwcXNmbjdhallQbXlWUldpMzdkaDl6UFQ4N0ZFcWIK",
      "endpoints": [
        "https://github.com/rishmakes/duet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
