#!/bin/bash
# Build Duet for Windows from what is pushed to main, and install it on the creator's test PC.
# No tag, no release: nobody else gets it. About 30 minutes, hands-off.
#   scripts/windows-test            build, download, install
#   scripts/windows-test --install  install the last build again, without building
#   BRANCH=next scripts/windows-test  build from another branch (main by default)
set -euo pipefail
PC="soumya nath@100.72.209.14"
DIR="$(mktemp -d)"
cd "$(dirname "$0")/.."

if [ "${1:-}" != "--install" ]; then
  gh workflow run windows-test.yml --ref "${BRANCH:-main}"
  sleep 10
  ID=$(gh run list --workflow windows-test.yml --limit 1 --json databaseId -q '.[0].databaseId')
  echo "Building on GitHub (run $ID)..."
  gh run watch "$ID" --exit-status --interval 60 > /dev/null
else
  ID=$(gh run list --workflow windows-test.yml --status success --limit 1 --json databaseId -q '.[0].databaseId')
fi

gh run download "$ID" -n duet-windows-test -D "$DIR"
EXE=$(ls "$DIR"/*-setup.exe | head -1)
cp "$EXE" "$DIR/duet-test-setup.exe"
echo "Copying to the PC..."
(cd "$DIR" && printf 'put duet-test-setup.exe\n' | sftp -b - "$PC" > /dev/null)

# install silently over Duet, but never while it is open: closing it by force once lost unsaved work.
# Duet cannot tell from out here what is unsaved, so any open Duet stops the install. Open it on the PC by hand.
cat > "$DIR/install.ps1" <<'EOF'
if (Get-Process -Name duet-app -ErrorAction SilentlyContinue) {
  "Duet is open on the PC. Save your work, close Duet, then run: scripts/windows-test --install"
  exit 3
}
Start-Process -FilePath "$env:USERPROFILE\duet-test-setup.exe" -ArgumentList "/S" -Wait
"installed: " + (Get-Item "$env:LOCALAPPDATA\Duet\duet-app.exe").LastWriteTime
EOF
(cd "$DIR" && printf 'put install.ps1\n' | sftp -b - "$PC" > /dev/null)
if ! ssh "$PC" 'powershell -NoProfile -ExecutionPolicy Bypass -File install.ps1'; then
  echo "Not installed. The build is kept on GitHub; run scripts/windows-test --install once Duet is closed on the PC."
  exit 1
fi
echo "Done: $(basename "$EXE") is on the test PC."
