#!/usr/bin/env bash
# Vulkan for Voice to text on Windows: the graphics card does the listening (#375).
# Run by the Windows builds on GitHub, before the app build. Both files are pinned and checked.
#
# 1. The Vulkan SDK, which whisper.cpp needs to be built with Vulkan. It never ships.
# 2. The Vulkan loader, vulkan-1.dll, which ships next to duet-app.exe, so Duet still opens on a PC
#    whose graphics driver brought none. With no usable graphics, Voice to text uses the processor.
#    It lands in src-tauri/binaries/, which is never committed. Apache 2.0, licence beside it.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

V=1.3.296.0
SDK_SUM=acb4ae0786fd3e558f8b3c36cc3eba91638984217ba8a6795ec64d2f9ffd8c4b
RT_SUM=e0429f91cf356fe99e381f7d22e568ac81945669f1be1772d933a0d189230452
BASE="https://sdk.lunarg.com/sdk/download/$V/windows"
T="$(mktemp -d)"

curl -fsSL -o "$T/sdk.exe" "$BASE/VulkanSDK-$V-Installer.exe"
echo "$SDK_SUM  $T/sdk.exe" | sha256sum -c -
ROOT="C:\\VulkanSDK\\$V"
"$T/sdk.exe" --root "$ROOT" --accept-licenses --default-answer --confirm-command install
if [ -n "${GITHUB_ENV:-}" ]; then
  echo "VULKAN_SDK=$ROOT" >> "$GITHUB_ENV"
  echo "$ROOT\\Bin" >> "$GITHUB_PATH"
fi

curl -fsSL -o "$T/rt.zip" "$BASE/VulkanRT-$V-Components.zip"
echo "$RT_SUM  $T/rt.zip" | sha256sum -c -
unzip -q "$T/rt.zip" -d "$T/rt"
mkdir -p src-tauri/binaries/vulkan-licence
cp "$T/rt/VulkanRT-$V-Components/x64/vulkan-1.dll" src-tauri/binaries/vulkan-1.dll
cp "$T/rt/VulkanRT-$V-Components/VulkanRT-License.txt" src-tauri/binaries/vulkan-licence/
echo "Vulkan $V ready."
